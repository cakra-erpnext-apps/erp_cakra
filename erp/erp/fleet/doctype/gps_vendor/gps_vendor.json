   "description": "Contoh: https://api.vendor.com"
  },
  {
   "fieldname": "positions_path",
   "fieldtype": "Data",
   "label": "Positions Endpoint",
   "description": "Path setelah base URL yang mengembalikan posisi SEMUA unit sekali panggil."
  },
  {
   "fieldname": "devices_path",
   "fieldtype": "Data",
   "label": "Devices Endpoint",
   "description": "Opsional, untuk tombol Tarik Unit. Kosong = pakai Positions Endpoint."
  },
  {
   "fieldname": "http_method",
