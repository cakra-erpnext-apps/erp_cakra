  },
  {
   "fieldname": "api_key",
   "fieldtype": "Password",
   "label": "API Key / Token",
   "depends_on": "eval:['API Key Header','Query Param','Basic','Bearer Token'].includes(doc.auth_type) || (doc.auth_type=='OAuth2 Client Credentials' && doc.send_api_key_header)",
