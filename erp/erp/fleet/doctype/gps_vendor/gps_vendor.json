   "fieldname": "sb_auth",
   "fieldtype": "Section Break",
   "label": "Auth"
  },
  {
   "fieldname": "auth_type",
   "fieldtype": "Select",
   "label": "Auth Type",
   "options": "None\nAPI Key Header\nQuery Param\nBearer Token\nBasic\nOAuth2 Client Credentials",
   "default": "API Key Header"
  },
  {
   "fieldname": "auth_key_name",
   "fieldtype": "Data",
   "label": "Key Name",
   "description": "Nama header/param, mis. x-api-key atau token. Untuk Basic, ini username.",
