# erp_cakra_prod isolated migration stack
SITE_NAME=app.cakraindo.com
COMPOSE_PROJECT_NAME=erp_cakra_prod
HTTP_PORT=18089
DB_ROOT_PASS=CHANGE_ME_STRONG
ADMIN_PASS=CHANGE_ME_STRONG

# Root MariaDB untuk migrate membuat database tambahan (fleet_db, mail_db) + GRANT.
# Biasanya sama dengan DB_ROOT_PASS. Kosongkan = tidak disimpan di config; GRANT manual.
MARIADB_ROOT_PASSWORD=
